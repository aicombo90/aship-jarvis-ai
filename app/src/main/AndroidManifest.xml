<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Voice commands -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- v29: call_person auzaar ke liye — "Rahul ko call
         karo" par Maya contacts me naam dhundhkar number
         dialer me bhar deti hai. Runtime par app khulne par
         ek baar maangi jati hai; mana karne par baaki app
         bilkul aam chalta hai. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- v60: ek-taap me seedha call — "মাকে ফোন করো"
         bolte hi call turant lag jaye (ACTION_CALL), dialer
         me number bhar kar call wala button dabane ki
         zaroorat na pade. v29 me ye permission jaan-boojh
         kar NAHI li gayi thi; user ne 2026-11-07 ko khud
         manga ke ek-taap call chahiye, isliye ab li gayi.
         Pehli baar call wale hukm par runtime par maangi
         jati hai; mana karne par purana raasta (dialer
         khula, number bhara) hi chalta hai. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- v63: mobile-data ki ASLI haalat (TelephonyManager.
         isDataEnabled) padhne ke liye — bina iske v62 wali
         jaanch SecurityException khakar null lautati thi,
         isliye "অন কর দিয়া" jhootha bola gaya tha (15:21)।
         Runtime par MainActivity se ek baar maangi jati hai;
         mana karne par jaanch vision/isChecked se, ya
         imaandaar "pata nahi" — jhootha SUCCESS kabhi nahi। -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- v73: mobile data SEEDHA system setting se badalne ke
         liye — panel/tile/vision ka bharosa chhodo (vivo
         SystemUI tile ko accessibility tree me dikhata hi
         nahi; 08:48 ko combo ne galat tile — flashlight —
         dabayi thi, data phir bhi ON raha)। Ye anumati
         runtime par kabhi NAHI maangi jati (maangne se milti
         hi nahi); computer se ek baar ADB se di jati hai:
         adb shell pm grant com.aship.jarvis android.permission.WRITE_SECURE_SETTINGS
         Manifest me likhna ZAROORI hai — bina ghoshna ke
         pm grant kaam hi nahi karta (PackageManager
         "Unknown permission" kehta hai)। Grant reboot aur
         app update ke baad bhi rehta hai। -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <!-- v96: brightness SEEDHA badalne ke liye
         (Settings.System.SCREEN_BRIGHTNESS) — ye "special
         access" hai, runtime dialog se nahi milti; user
         app se khule Settings screen me ek baar Allow karta
         hai (code me canWrite() jaanch kar khud hi woh
         screen kholta hai)। Na mile to brightness ka hukm
         imaandaar manaahi dega — jhootha "badh gaya" nahi। -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <!-- Downloading the offline Vosk model; later also online AI -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- v21 Phase 3: Gemini ko bulane se pehle net chalu hai ya
         nahi, ye ConnectivityManager se jaanchna hai — usi jaanch
         ke liye ye aam (normal) permission chahiye. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- v96: WiFi ki ASLI haalat (WifiManager.isWifiEnabled)
         padhne ke liye — QS tile dabane ke baad "chal gaya ya
         nahi" ki jaanch isse hoti hai (mobile data wali
         READ_PHONE_STATE jaisi hi baat)। Ye aam (normal)
         permission hai — install par mil jati hai, koi
         runtime dialog nahi aata। SetWifiEnabled se WiFi
         seedha badla NAHI jata (Android 10+ par third-party
         app ke liye band hai) — toggle QS tile se hota hai,
         ye sirf haalat padhne ke liye hai। -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Opening / pre-filling the alarm screen -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- v59: voice reminders — exact alarm mile to exact, warna
         inexact (canScheduleExactAlarms ki jaanch code me hai). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- v68: reboot ke baad reminder dobara lagana — boot ka
         broadcast sunne ke liye ye aam (normal) permission
         chahiye; koi runtime dialog nahi aata. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Phase 2: background wake-word listening runs as a foreground
         service with microphone type. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- So the foreground-service notice can be shown (asked at runtime
         on Android 13+; the service runs even if it is denied). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- v16: wake word sunte hi screen ki roshni jalani hai, screen
         band ho tab bhi. Wake service ek chhota sa SCREEN_BRIGHT
         wake lock leti hai — ye aam (normal) permission hai, koi
         runtime dialog nahi aata. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Phase 2: lets the user exempt Jarvis from battery optimization
         from inside the app (vivo kills background apps otherwise). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Phase 2 fix: Android 10+ background service se startActivity
         chup-chaap rok deta hai (Jarvis "khol diya" bol deta tha, app
         khulta nahi tha). Wake service launch ke pal bhar ke liye ek
         1x1 adrishya overlay window dikhakar app kholta hai. Ye
         "special access" hai — user app ke andar wale button se
         Settings me jaakar deta hai; koi runtime dialog nahi aata. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- In-app update: GitHub Release se download hua APK install
         karne ke liye. User ko ek baar "Install unknown apps" me
         Allow karna padta hai; bina uske download shuru hi nahi hota. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Torch control uses the camera flash hardware, but the app works on
         phones without a flash too. -->
    <uses-feature
        android:name="android.hardware.camera.flash"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <!-- Package visibility (Android 11+): lets Jarvis find the speech
         recognition service and the apps it can open by voice. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- v1.4: "koi bhi app naam bolkar kholo" ke liye launcher ki
             saari apps ki list dekhni padti hai, aur Google/YouTube
             search ke liye browser ka hona jaanchna padta hai. Ye
             <queries> wale intent hi un apps ko dikhai dene dete hain —
             QUERY_ALL_PACKAGES jaisi badi permission nahi li gayi. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <package android:name="com.google.android.youtube" />
        <package android:name="com.facebook.katana" />
        <package android:name="com.whatsapp" />
        <package android:name="com.android.chrome" />
    </queries>

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <!-- v54: main screen halki (light) theme me — purana
             andhera theme hi screen ko "hacker-type" dikhata
             tha; baaki activityan waisi hi rehti hain. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- v34: Mobile hub — background bandobosto ab yahin
             se hota hai: pehle mobile chuno (vivo / Samsung),
             phir us company wali setup screen. -->
        <activity
            android:name=".MobileHubActivity"
            android:exported="false" />

        <activity
            android:name=".VivoSetupActivity"
            android:exported="false" />

        <activity
            android:name=".SamsungSetupActivity"
            android:exported="false" />

        <!-- v53: API Keys wali screen — saare free provideron ki key ek jagah। -->
        <activity
            android:name=".ApiKeysActivity"
            android:exported="false" />

        <!-- Phase 2: wake-word foreground service. Not exported; only
             this app's UI starts and stops it. -->
        <service
            android:name=".service.JarvisWakeService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- v17: Accessibility service — EK hi kaam: "mobile data
             on/off karo" par quick-settings ka data tile dabana
             (Android aam app ko data seedha badalne nahi deta).
             User Settings > Accessibility se khud ON karta hai;
             bina uske service band rehti hai aur Jarvis saaf mana
             kar deta hai. Iske alawa koi screen automation nahi
             hota. BIND_ACCESSIBILITY_SERVICE permission ki wajah
             se sirf Android system hi ise bandh sakta hai. -->
        <service
            android:name=".access.JarvisAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>

        <!-- v98: notification se jawab — message notification
             padhkar awaaz se jawab bhejne ke liye
             NotificationListenerService। User Settings >
             Notifications > Notification access se khud ON
             karta hai; bina uske service band rehti hai aur
             Maya saaf mana kar deti hai। Khud se kuch padhkar
             NAHI sunati, khud se jawab NAHI bhejti — sirf
             user ke bole hukm par। BIND_NOTIFICATION_LISTENER_SERVICE
             permission ki wajah se sirf Android system hi ise
             bandh sakta hai (v17 wali accessibility service
             jaisa hi niyam)। -->
        <service
            android:name=".service.JarvisNotificationListener"
            android:exported="true"
            android:label="@string/notification_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- v59: voice reminders — AlarmManager is receiver ko
             jagata hai; notification + awaaz se yaad dilata hai. -->
        <receiver
            android:name=".commands.ReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.aship.jarvis.REMINDER_FIRE" />
            </intent-filter>
        </receiver>

        <!-- v68: reboot ke baad reminder dobara lagana —
             AlarmManager ke alarm reboot par mit jate hain,
             isliye boot hote hi BootReceiver bachi hui
             (bhavishya wali) yaadein phir se laga deta hai;
             beet chuki yaadein hata di jati hain. exported=true
             isliye: BOOT_COMPLETED system bhejta hai (app ke
             bahar se); receiver ka kaam idempotent hai — apni
             hi list padhkar apne hi alarm dobara lagana. -->
        <receiver
            android:name=".commands.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- In-app update: download hue APK ko system installer tak
             pahunchane ke liye FileProvider. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
