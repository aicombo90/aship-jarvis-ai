<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Voice commands -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Downloading the offline Vosk model; later also online AI -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Opening / pre-filling the alarm screen -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- Torch control uses the camera flash hardware, but the app works on
         phones without a flash too. -->
    <uses-feature
        android:name="android.hardware.camera.flash"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <!-- Package visibility (Android 11+): lets Jarvis find the speech
         recognition service and the apps it can open by voice. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <package android:name="com.google.android.youtube" />
        <package android:name="com.facebook.katana" />
        <package android:name="com.whatsapp" />
        <package android:name="com.android.chrome" />
    </queries>

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
