<?xml version="1.0" encoding="utf-8"?>
<!-- v22: jad (root) ab ScrollView hai. Pehle poora content ek
     bina-scroll wale LinearLayout me tha — screen se lamba
     content neeche kat jata tha aur Gemini key wala hissa
     kabhi pahunch me hi nahi aata tha. Ab saare hisse ek hi
     scroll hone wale dabbe ke andar hain, aur Gemini key ka
     hissa Mode ke turant baad upar rakh diya gaya hai. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ASHIP JARVIS AI"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Status: taiyaar ho raha hai..."
            android:textSize="13sp" />

        <!-- v51: Hindi offline pack ki salaah — net
             kamzor ho to online wala kaan baar-baar
             fail hota hai; pack ho to wahi kaan bina
             net ke bhi sunega. Line tab tak dikhti hai
             jab tak offline kaan asal me safal na ho
             ya malik use band na kar de. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/offlinePackHintText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="💡 Google অ্যাপ → Settings → Voice → Offline speech থেকে हिन्दी প্যাক ডাউনলোড করলে নেট ছাড়াও ভালো শুনবে"
                android:textSize="13sp" />

            <Button
                android:id="@+id/offlinePackHintClose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✕ বন্ধ করুন" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Mode:"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/modeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/modeOffline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Offline" />

            <RadioButton
                android:id="@+id/modeOnline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Online" />

            <RadioButton
                android:id="@+id/modeAuto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Auto" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Maya ki online buddhi (Gemini API key)"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/geminiKeyStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Key: nahi hai"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/geminiDiagText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Online koshish (aakhiri): abhi tak koi koshish nahi"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/geminiKeyInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/input_box_bg"
            android:hint="Yahan apna Gemini API key likho"
            android:importantForAutofill="no"
            android:inputType="textPassword"
            android:maxLines="1"
            android:minHeight="52dp"
            android:padding="12dp" />

        <Button
            android:id="@+id/geminiKeySaveButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="KEY SAVE KARO" />

        <Button
            android:id="@+id/geminiKeyClearButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="KEY HATAO" />

        <Button
            android:id="@+id/micButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="16dp"
            android:text="🎤 Tap to speak"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/recognizedText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Aapne kaha: —"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/responseText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Jarvis: —"
            android:textSize="15sp" />

        <!-- v50: likhkar command bhejna — bolkar jo
             hota hai, likhkar bhi wahi (pakke offline
             hukm pehle, phir mastishk); sikhana aur
             naam bandhna bhi yahin se hota hai. -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="✍️ লিখে কমান্ড পাঠান"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/commandInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/input_box_bg"
            android:hint="এখানে কমান্ড লিখুন (যেমন: টেলিগ্রাম খোলো, লাইট, স্ক্রল ডাউন)"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:minHeight="52dp"
            android:padding="12dp" />

        <Button
            android:id="@+id/sendButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="কমান্ড পাঠাও" />

        <Button
            android:id="@+id/downloadModelButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Download Hindi offline voice model" />

        <!-- v41: Bangla offline model (Zipformer, ~71 MB) —
             APK ke andar nahi hai; malik chahe to yahin se
             ek baar download hota hai, phir background
             Bangla hukm poori tarah offline suna jata hai. -->
        <TextView
            android:id="@+id/banglaModelStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="বাংলা অফলাইন মডেল: ডাউনলোড হয়নি"
            android:textSize="13sp" />

        <Button
            android:id="@+id/banglaModelButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="বাংলা অফলাইন মডেল ডাউনলোড করো" />

        <!-- v34: background bandobosto (wake word, battery,
             accessibility, overlay) ab ek hi "Mobile" button ke
             peeche hai — Mobile hub me vivo / Samsung ki alag
             screenon par. Neeche sirf report wali lines hain. -->
        <Button
            android:id="@+id/mobileSettingsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="📱 Mobile (মোবাইল) — Background Setup" />

        <TextView
            android:id="@+id/panelScanText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Panel scan: abhi tak koi koshish nahi"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/youtubeTapText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="YouTube tap (aakhiri): abhi tak koi koshish nahi"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/agentRunText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Agent chaal (aakhiri): abhi tak koi koshish nahi"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/screenRunText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Screen chaal (aakhiri): abhi tak koi koshish nahi"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/screenAuditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Screen audit (aakhiri): abhi tak koi record nahi"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/banglaAsrText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Bangla ASR (aakhiri): abhi tak koi koshish nahi"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/quotaText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Quota hisaab (aaj): total 0 | main 0 | lite 0"
            android:textSize="12sp" />

        <!-- v48: aakhiri background session ki shaksiyat
             (Maya-Hindi / Tara-Bangla) aur uska ant kis
             wajah se hua — wake service ki report. -->
        <TextView
            android:id="@+id/personaText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Persona (aakhiri): abhi tak koi session nahi"
            android:textSize="12sp" />

        <!-- v49: seekhe hue kaamon (routines) ki kul
             ginati — naam bolkar sunne par milte hain. -->
        <TextView
            android:id="@+id/learnedText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="শেখা কাজ (mot): 0"
            android:textSize="12sp" />

        <!-- v50: sikhaye hue shabd-kaam (trigger)
             jodon ki ginati — naam/jod bolkar
             "কী কী শেখানো আছে" par milte hain. -->
        <TextView
            android:id="@+id/taughtText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="শেখানো কমান্ড (mot): 0"
            android:textSize="12sp" />

        <!-- v52: kaam ke niyamon (brain rules) ki kul
             ginati — niyam bolkar sunne par milte hain. -->
        <TextView
            android:id="@+id/rulesText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="মনে রাখা নিয়ম (mot): 0"
            android:textSize="12sp" />

        <!-- v51: sunne ki report — background ne
             aakhiri kya suna, saamne wali screen ne
             aakhiri kya suna, aur sunne ka raasta
             (kaun sa kaan, kis bhasha me, kya error)।
             Galat-sunne ya bip ki shikayat par asal
             wajah inhi teen lineon se milegi. -->
        <TextView
            android:id="@+id/backgroundHeardText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Background (aakhiri suna): abhi tak kuch nahi"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/foregroundHeardText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Saamne (aakhiri suna): abhi tak kuch nahi"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/hearPathText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="শোনার পথ (aakhiri): abhi tak koi turn nahi"
            android:textSize="12sp" />

        <!-- v35: shune wali bhasha ek chhoti si label me bhi
             dikhao — galat setting ek nazar me pakdi jaye. -->
        <TextView
            android:id="@+id/listenLangLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="শোনার ভাষা: বাংলা"
            android:textSize="13sp" />

        <Button
            android:id="@+id/listenLangButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="শোনার ভাষা: বাংলা (বদলাতে ট্যাপ করো)" />

        <!-- v51: "offline kaan pehle" wala vaikalpik
             badlav — chalu ho to command pehle offline
             kaan (Vosk/Zipformer) se suna jayega:
             bip kam, par sunna thoda kamzor. Default
             band; band ho to sab bilkul pehle jaisa. -->
        <Switch
            android:id="@+id/offlineEarsFirstSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="অফলাইন কান আগে (বিপ কম, শোনা একটু কম)"
            android:textSize="14sp" />

        <Button
            android:id="@+id/updateCheckButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="UPDATE CHECK KARO" />

    </LinearLayout>

</ScrollView>
